# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# Assistant userbot session that joins voice chats (Pyrogram string session)
STRING_SESSION=
# Optional second assistant session
STRING_SESSION2=

# MongoDB connection string, Atlas free tier works
MONGO_DB_URI=

# Log group ID, add the bot there as admin
LOGGER_ID=

# Your Telegram user ID
OWNER_ID=

# Optional profile fields shown in the bot
OWNER_USERNAME=
BOT_USERNAME=
BOT_NAME=
ASSUSERNAME=
BOT_LINK=https://t.me/MeowClonerbot

# Optional support links
SUPPORT_CHANNEL=https://t.me/Meowcloner
SUPPORT_CHAT=https://t.me/MeowClone

# Maximum track length in minutes
DURATION_LIMIT=17000

# Optional playlist and file size limits
PLAYLIST_FETCH_LIMIT=25
TG_AUDIO_FILESIZE_LIMIT=5242880000
TG_VIDEO_FILESIZE_LIMIT=5242880000
SONG_DOWNLOAD_DURATION=9999999
SONG_DOWNLOAD_DURATION_LIMIT=9999999

# Optional clone garbage collection in hours, 0 disables it
CLONE_GC=0

# Optional assistant auto leave behaviour
AUTO_LEAVING_ASSISTANT=False
ASSISTANT_LEAVE_TIME=9000

# Optional Spotify credentials for metadata
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional music API endpoints
MEOW_API_URL=https://music.yukiapi.site
MEOW_API_KEY=
MEOW_FALLBACK_API_URL=https://play.yukiapi.site

# Optional image overrides
START_IMG_URL=https://telegra.ph/file/3ef2cc0ad2bc548bafb30.jpg
HELP_IMG_URL=
PING_IMG_URL=
PLAYLIST_IMG_URL=
STATS_IMG_URL=
TELEGRAM_AUDIO_URL=
TELEGRAM_VIDEO_URL=
STREAM_IMG_URL=
SOUNCLOUD_IMG_URL=
YOUTUBE_IMG_URL=
SPOTIFY_ARTIST_IMG_URL=
SPOTIFY_ALBUM_IMG_URL=
SPOTIFY_PLAYLIST_IMG_URL=

# Optional Heroku and self update settings
HEROKU_APP_NAME=
HEROKU_API_KEY=
GIT_TOKEN=
UPSTREAM_BRANCH=main
